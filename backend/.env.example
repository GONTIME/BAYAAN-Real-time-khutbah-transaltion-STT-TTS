# =============================================================================
# BAYAAN — complete configuration reference
# =============================================================================
# Copy this file to `backend/.env` (or set the same variables in your shell)
# before starting the server. Every configurable option is listed below with a
# brief description and its DEFAULT value (commented out = keep the default).
#
# Conventions:
#   * All settings use the BAYAAN_ prefix with "__" nesting (pydantic-settings).
#   * A real shell/CI env var ALWAYS overrides a value in `.env`.
#   * Uncomment + edit a line to change it; leave it commented to keep the default.
#   * The backend loads `backend/.env` automatically via get_settings().
#
# Operational guides: ../README.md and ../HOW_TO_RUN_AND_USE_BAYAAN.md
# =============================================================================

# --- Core -------------------------------------------------------------------
#BAYAAN_APP_NAME=Bayaan Server
#BAYAAN_ENVIRONMENT=development            # development | staging | production
#BAYAAN_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# --- Languages --------------------------------------------------------------
BAYAAN_LANGUAGES__SOURCE_LANGUAGE=ar            # language spoken from the minbar
BAYAAN_LANGUAGES__TARGET_LANGUAGES=["it","en"]  # JSON list of translation targets

# --- Audio capture (ADR-0014) ------------------------------------------------
# Master switch for PC audio input (WAV uploads from the operator always work).
# Mode "server_device": server captures a sounddevice input (needs `[audio]` extra).
# Mode "browser": operator's browser captures the mic and streams PCM over the WS.
#BAYAAN_AUDIO__INPUT_DEVICE=default
#BAYAAN_AUDIO__SAMPLE_RATE=16000
#BAYAAN_AUDIO__CHANNELS=1
#BAYAAN_AUDIO__CAPTURE_ENABLED=false
#BAYAAN_AUDIO__CAPTURE_MODE=server_device    # server_device | browser
#BAYAAN_AUDIO__INGEST_WS_ENABLED=true        # allow browser ingest WebSocket

# --- PC camera relay (ADR-0015) ----------------------------------------------
# Operator browser webcam -> server (JPEG frames) -> MJPEG to projector/rooms.
#BAYAAN_CAMERA__CAPTURE_ENABLED=true
#BAYAAN_CAMERA__WIDTH=640
#BAYAAN_CAMERA__HEIGHT=360
#BAYAAN_CAMERA__FRAMES_PER_SECOND=10
#BAYAAN_CAMERA__JPEG_QUALITY=0.6
#BAYAAN_CAMERA__MAX_FRAME_BYTES=524288
#BAYAAN_CAMERA__MAX_VIEWERS_PER_SESSION=10
#BAYAAN_CAMERA__MAX_INVALID_FRAMES=3         # non-JPEG frames before WS close 4431
#BAYAAN_CAMERA__VIEWER_POLL_INTERVAL_SECONDS=0.25

# --- Voice activity detection (VAD) ------------------------------------------
#BAYAAN_VAD__RMS_SPEECH_THRESHOLD=500.0      # RMS level that counts as speech
#BAYAAN_VAD__SILENCE_MS_TO_CLOSE=700         # silence before an utterance closes
#BAYAAN_VAD__MIN_UTTERANCE_MS=400            # ignore blips shorter than this
#BAYAAN_VAD__MAX_UTTERANCE_MS=30000          # hard cap on one utterance
#BAYAAN_VAD__PRE_SPEECH_PAD_MS=120           # audio kept before speech starts

# --- Database ----------------------------------------------------------------
# Postgres (production):  pip install -e ".[postgres]"
#   BAYAAN_DATABASE__URL=postgresql+asyncpg://bayaan:bayaan@localhost:5432/bayaan
# Dev default: local SQLite file (no service needed).
BAYAAN_DATABASE__URL=sqlite+aiosqlite:///./bayaan_dev.db
#BAYAAN_DATABASE__ECHO_SQL=false             # log every SQL statement

# --- Providers (ASR / translation / TTS) -------------------------------------
# ASR: mock (dev) | whisper (OpenAI/Groq-compatible HTTP API)
BAYAAN_PROVIDERS__ASR=mock
# Translation: mock | mock-failing | libre | ollama | ollama_cloud
BAYAAN_PROVIDERS__TRANSLATION=mock
# TTS: mock (silence) | disabled | piper (offline local voices)
BAYAAN_PROVIDERS__TTS=mock
# Optional second-choice provider per capability (empty = no fallback). The
# failover layer (BAYAAN_FAILOVER__*) retries primary -> fallback -> SAFE_DROP.
#BAYAAN_PROVIDERS__ASR_FALLBACK=
#BAYAAN_PROVIDERS__TRANSLATION_FALLBACK=
#BAYAAN_PROVIDERS__TTS_FALLBACK=

# --- Mock provider knobs (development/simulation only) -----------------------
#BAYAAN_PROVIDERS__MOCK_ASR_CONFIDENCE=0.9
#BAYAAN_PROVIDERS__MOCK_TRANSLATION_CONFIDENCE=0.9
#BAYAAN_PROVIDERS__MOCK_ASR_FAIL_ALWAYS=false
#BAYAAN_PROVIDERS__MOCK_TRANSLATION_FAIL_ALWAYS=false
#BAYAAN_PROVIDERS__MOCK_ASR_TEXT=            # fixed "recognized" Arabic text

# --- Whisper ASR (cloud) -----------------------------------------------------
#BAYAAN_PROVIDERS__WHISPER_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
#BAYAAN_PROVIDERS__WHISPER_API_KEY=          # secret; never commit
#BAYAAN_PROVIDERS__WHISPER_MODEL=whisper-1
#BAYAAN_PROVIDERS__WHISPER_TIMEOUT_SECONDS=30.0

# --- LibreTranslate (self-hosted MT) -----------------------------------------
#BAYAAN_PROVIDERS__LIBRE_ENDPOINT=http://localhost:5000
#BAYAAN_PROVIDERS__LIBRE_TIMEOUT_SECONDS=15.0
#BAYAAN_PROVIDERS__LIBRE_API_KEY=            # only if the instance is key-protected
#BAYAAN_PROVIDERS__LIBRE_PROMPT_VERSION=libre-v1

# --- Local Ollama LLM MT (offline, free; Arabic-strong models) ---------------
#BAYAAN_PROVIDERS__OLLAMA_ENDPOINT=http://localhost:11434
#BAYAAN_PROVIDERS__OLLAMA_MODEL=aya:8b
#BAYAAN_PROVIDERS__OLLAMA_TIMEOUT_SECONDS=60.0
#BAYAAN_PROVIDERS__OLLAMA_TEMPERATURE=0.2
#BAYAAN_PROVIDERS__OLLAMA_PROMPT_VERSION=ollama-v1
#BAYAAN_PROVIDERS__OLLAMA_KEEP_ALIVE=-1      # -1 pins model in RAM (big latency win)
#BAYAAN_PROVIDERS__OLLAMA_NUM_CTX=2048
#BAYAAN_PROVIDERS__OLLAMA_NUM_THREAD=0       # 0 = auto-detect cores
#BAYAAN_PROVIDERS__OLLAMA_NUM_BATCH=512

# --- Ollama Cloud MT (opt-in; text leaves the mosque, §58 deviation) ---------
#BAYAAN_PROVIDERS__OLLAMA_CLOUD_ENDPOINT=https://ollama.com
#BAYAAN_PROVIDERS__OLLAMA_CLOUD_MODEL=gemma4:31b
#BAYAAN_PROVIDERS__OLLAMA_CLOUD_API_KEY=     # secret; never commit
#BAYAAN_PROVIDERS__OLLAMA_CLOUD_TIMEOUT_SECONDS=45.0
#BAYAAN_PROVIDERS__OLLAMA_CLOUD_PROMPT_VERSION=ollama-cloud-v1
#BAYAAN_PROVIDERS__OLLAMA_CLOUD_TEMPERATURE=1.0
#BAYAAN_PROVIDERS__OLLAMA_CLOUD_TOP_P=0.95
#BAYAAN_PROVIDERS__OLLAMA_CLOUD_TOP_K=64
#BAYAAN_PROVIDERS__OLLAMA_CLOUD_THINKING=false   # translate-only (no chain-of-thought)

# --- Piper / Sherpa-ONNX local TTS (offline, CPU-only) -----------------------
# Set TTS=piper above and provide a real binary + the three voices, then set:
#BAYAAN_PROVIDERS__PIPER_EXEC=piper          # path to the piper/sherpa CLI
#BAYAAN_PROVIDERS__PIPER_VOICE_DIR=          # folder containing <voice>.onnx+json
#BAYAAN_PROVIDERS__PIPER_VOICE_AR=ar_JO-kareem-medium
#BAYAAN_PROVIDERS__PIPER_VOICE_IT=it_IT-paola-medium
#BAYAAN_PROVIDERS__PIPER_VOICE_EN=en_US-lessac-medium

# --- Safety (gates never override an overall average, §166-§168) -------------
# Any per-signal breach below forces BLOCK regardless of the composite.
#BAYAAN_SAFETY__TTS_ENABLED=true             # master on/off for spoken audio (§201)
#BAYAAN_SAFETY__ASR_MIN_CONFIDENCE=0.60
#BAYAAN_SAFETY__ALIGNMENT_MIN_CONFIDENCE=0.70
#BAYAAN_SAFETY__TRANSLATION_MIN_CONFIDENCE=0.70
#BAYAAN_SAFETY__TTS_MIN_CONFIDENCE=0.90     # only high-confidence lines may be spoken
#BAYAAN_SAFETY__OVERALL_MIN_CONFIDENCE=0.75 # below this -> public fallback, never broadcast
# Composite weights must sum to 1.0:
#BAYAAN_SAFETY__WEIGHTS__ASR=0.25
#BAYAAN_SAFETY__WEIGHTS__ALIGNMENT=0.25
#BAYAAN_SAFETY__WEIGHTS__TRANSLATION=0.35
#BAYAAN_SAFETY__WEIGHTS__VALIDATION=0.15
#BAYAAN_SAFETY__ALIGNMENT_ENABLED=true      # aligner engine (Phase 4)
#BAYAAN_SAFETY__VALIDATION_ENABLED=true     # validator chain (Phase 4)
#BAYAAN_SAFETY__FALLBACK_SHOW_ARABIC=true   # show Arabic alongside the fallback text

# --- Validation chain (§79, Phase 4) -----------------------------------------
#BAYAAN_VALIDATION__CHECK_NUMBERS=true      # CRITICAL on number change
#BAYAAN_VALIDATION__CHECK_NEGATION=true     # CRITICAL on polarity flip
#BAYAAN_VALIDATION__CHECK_ENTITIES=true     # named-entity enforcement
#BAYAAN_VALIDATION__CHECK_GLOSSARY=true     # approved-term presence
#BAYAAN_VALIDATION__CHECK_ADDITIONS=true    # no invented commentary
#BAYAAN_VALIDATION__CHECK_SCRIPTURE=true    # sacred-text reference policy
#BAYAAN_VALIDATION__MAX_LENGTH_RATIO=2.5    # target/source length guard
#BAYAAN_VALIDATION__HIGH_RISK_THRESHOLD=0.5
#BAYAAN_VALIDATION__MEDIUM_RISK_THRESHOLD=0.2
#BAYAAN_VALIDATION__HADITH_REQUIRES_REFERENCE=false

# --- TTS operational tuning (§88, §194) --------------------------------------
# The on/off switch is BAYAAN_SAFETY__TTS_ENABLED above; this block is tuning.
#BAYAAN_TTS__MAX_STALENESS_MS=8000          # drop audio older than this (§88)
#BAYAAN_TTS__QUEUE_MAXSIZE=32               # bounded queue (§149)
#BAYAAN_TTS__SAMPLE_RATE=24000
#BAYAAN_TTS__MAX_AUDIO_SECONDS=12.0         # cap one spoken segment's length
# §80/§166: real MT providers (ollama/ollama_cloud/libre) report NO confidence
# score, so the gate refuses every line unless you opt out here. False = speak
# translations from score-less providers (all other §80 rules still apply; a
# NUMERIC confidence below BAYAAN_SAFETY__TTS_MIN_CONFIDENCE is always refused).
#BAYAAN_TTS__REQUIRE_TRANSLATION_CONFIDENCE=true

# --- Failover / circuit breaker (§54, §87, §111) -----------------------------
#BAYAAN_FAILOVER__REQUEST_TIMEOUT_MS=10000          # primary call budget
#BAYAAN_FAILOVER__FALLBACK_TIMEOUT_MS=4000          # fallback (short) budget
#BAYAAN_FAILOVER__TRANSLATION_REQUEST_TIMEOUT_MS=65000   # LLM MT needs more time
#BAYAAN_FAILOVER__TRANSLATION_FALLBACK_TIMEOUT_MS=30000
#BAYAAN_FAILOVER__FAILURE_THRESHOLD=3               # consecutive failures -> circuit OPEN
#BAYAAN_FAILOVER__COOLDOWN_MS=30000                 # OPEN -> HALF_OPEN wait
#BAYAAN_FAILOVER__HEARTBEAT_TIMEOUT_MS=15000        # §111 staleness threshold
#BAYAAN_FAILOVER__WATCHDOG_INTERVAL_MS=5000         # §111 polling cadence

# --- Alerts (§195; structured log now, optional webhook) ---------------------
#BAYAAN_ALERTS__ENABLED=true
#BAYAAN_ALERTS__MIN_SEVERITY=warning          # info | warning | error
#BAYAAN_ALERTS__WEBHOOK_URL=                  # outbound delivery (empty = log only)

# --- Alignment (§77 aligner, Phase 4) ----------------------------------------
#BAYAAN_ALIGNMENT__ENABLED=true
#BAYAAN_ALIGNMENT__WINDOW_SIZE=5
#BAYAAN_ALIGNMENT__CONFIRM_THRESHOLD=0.72
#BAYAAN_ALIGNMENT__CANDIDATE_THRESHOLD=0.45
#BAYAAN_ALIGNMENT__LEXICAL_WEIGHT=0.45
#BAYAAN_ALIGNMENT__FUZZY_WEIGHT=0.35
#BAYAAN_ALIGNMENT__TEMPORAL_WEIGHT=0.1
#BAYAAN_ALIGNMENT__CONTINUITY_WEIGHT=0.1

# --- Scripture / sacred-text policy (§78) ------------------------------------
#BAYAAN_SCRIPTURE__NEAR_MATCH_THRESHOLD=0.85
#BAYAAN_SCRIPTURE__REVIEW_THRESHOLD=0.55
#BAYAAN_SCRIPTURE__QURAN_BLOCK_WITHOUT_REFERENCE=true
#BAYAAN_SCRIPTURE__HADITH_FALLBACK_GENERAL=true

# --- Security (§116 visitor tokens; CHANGE THE SECRET IN PRODUCTION) ----------
#BAYAAN_SECURITY__VISITOR_TOKEN_SECRET=dev-insecure-secret-change-me
#BAYAAN_SECURITY__VISITOR_TOKEN_TTL_MINUTES=720

# --- Operator auth (§116, ADR-0004; CHANGE CREDENTIALS IN PRODUCTION) ---------
#BAYAAN_AUTH__USERNAME=admin
#BAYAAN_AUTH__PASSWORD=admin
#BAYAAN_AUTH__OPERATOR_TOKEN_SECRET=dev-insecure-operator-secret-change-me
#BAYAAN_AUTH__TOKEN_TTL_HOURS=24

# --- Live transcript (semantic segmentation of khutbah) -----------------------
#BAYAAN_LIVE_TRANSCRIPT__ENABLED=true
#BAYAAN_LIVE_TRANSCRIPT__MIN_WORDS_PER_SEGMENT=6
#BAYAAN_LIVE_TRANSCRIPT__MAX_WORDS_PER_SEGMENT=22
#BAYAAN_LIVE_TRANSCRIPT__MAX_CHARS_PER_SEGMENT=140

# --- Rate limiting (§115: per-category, never one global limit) ---------------
#BAYAAN_RATE_LIMIT__ENABLED=true
#BAYAAN_RATE_LIMIT__DISCOVERY_PER_MINUTE=30
#BAYAAN_RATE_LIMIT__WS_PER_MINUTE=60
#BAYAAN_RATE_LIMIT__ADMIN_PER_MINUTE=120

# --- WebSocket broadcast (§55, §188) -----------------------------------------
#BAYAAN_REALTIME__HISTORY_SIZE=20            # captions replayed to a late joiner

# --- Room / join codes -------------------------------------------------------
#BAYAAN_ROOM__CODE_LENGTH=8

# --- Sermon drafts (upload + segmentation) -----------------------------------
#BAYAAN_SERMON__MAX_UPLOAD_BYTES=10485760    # 10 MB
#BAYAAN_SERMON__ALLOWED_EXTENSIONS=["txt","md","docx","pdf"]
#BAYAAN_SERMON__MIN_SEGMENT_CHARS=30
#BAYAAN_SERMON__MAX_SEGMENT_CHARS=500
#BAYAAN_SERMON__STORAGE_ROOT=storage         # where uploaded drafts are kept

# --- Session concurrency (§149 bounded resources) ----------------------------
#BAYAAN_MAX_ACTIVE_SESSIONS=4

# --- Public reachability (§197/§191) ------------------------------------------
# The base URL phones actually reach the app at. Set to YOUR PC's LAN address so
# the QR code + join link work from phones on the same Wi-Fi (the dev proxy Host
# is always 127.0.0.1 otherwise). Find it with:
#   (Get-NetIPAddress -AddressFamily IPv4 | ? PrefixOrigin -ne 'WellKnown').IPAddress
# Empty = fall back to the incoming request's base URL.
#BAYAAN_PUBLIC_BASE_URL=http://192.168.1.17:5173



